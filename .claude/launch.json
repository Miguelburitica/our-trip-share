{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATA_BACKEND=memory",
        "npx",
        "next",
        "dev",
        "-p",
        "3000"
      ],
      "port": 3000
    }
  ]
}