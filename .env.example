# Copy to .env.local. Local values come from `npx supabase status`.
# memory (default): seeded demo trip, no Docker. supabase: Postgres + real sign-in.
DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional, server only: reads receipt photos through OpenRouter to pre-fill quick add.
# Without it, photos are still attached to expenses but not read.
OPENROUTER_API_KEY=
# Any OpenRouter model with image input (default openai/gpt-6-luna).
OPENROUTER_RECEIPT_MODEL=
